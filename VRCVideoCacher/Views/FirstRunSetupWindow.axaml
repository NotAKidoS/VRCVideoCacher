<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VRCVideoCacher.ViewModels"
        xmlns:l="using:Jeek.Avalonia.Localization"
        x:Class="VRCVideoCacher.Views.FirstRunSetupWindow"
        x:DataType="vm:FirstRunSetupViewModel"
        Title="{l:Localize FirstRunTitle}"
        Width="550"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Grid RowDefinitions="Auto, Auto, Auto, Auto" Margin="20">
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="{l:Localize FirstRunTitle}" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="{l:Localize FirstRunSubtitle}" Foreground="#888888" Margin="0,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Game Patching -->
        <Border Grid.Row="1" Background="#2d2d2d" CornerRadius="8" Padding="20" Margin="0,0,0,15">
            <StackPanel Spacing="12">
                <TextBlock Text="{l:Localize GamePatching}" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="{l:Localize FirstRunGamePatchingDesc}" TextWrapping="Wrap" Foreground="#cccccc"/>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <CheckBox IsChecked="{Binding PatchVrChat}" Content="{l:Localize PatchVRChat}"/>
                    <TextBlock Text="{l:Localize GameNotDetected}" Foreground="#888888"
                               VerticalAlignment="Center" IsVisible="{Binding IsVrChatNotDetected}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <CheckBox IsChecked="{Binding PatchResonite}" Content="{l:Localize PatchResonite}"/>
                    <TextBlock Text="{l:Localize GameNotDetected}" Foreground="#888888"
                               VerticalAlignment="Center" IsVisible="{Binding IsResoniteNotDetected}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <CheckBox IsChecked="{Binding PatchChilloutVR}" Content="{l:Localize PatchChilloutVR}"/>
                    <TextBlock Text="{l:Localize GameNotDetected}" Foreground="#888888"
                               VerticalAlignment="Center" IsVisible="{Binding IsChilloutVRNotDetected}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Caching & misc -->
        <Border Grid.Row="2" Background="#2d2d2d" CornerRadius="8" Padding="20" Margin="0,0,0,15">
            <StackPanel Spacing="12">
                <TextBlock Text="{l:Localize FirstRunCachingHeader}" FontSize="16" FontWeight="SemiBold"/>
                <CheckBox IsChecked="{Binding CacheYouTube}" Content="{l:Localize CacheYouTubeVideos}"/>
                <CheckBox IsChecked="{Binding CacheDanceVideos}" Content="{l:Localize CacheDanceVideos}"/>
                <CheckBox IsChecked="{Binding AddVrcxAutoStart}" Content="{l:Localize AddToVrcxAutoStart}"
                          IsVisible="{Binding IsVrcxAutoStartVisible}"/>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Button Grid.Row="3" Content="{l:Localize FirstRunContinue}"
                Command="{Binding ContinueCommand}"
                HorizontalAlignment="Right" Padding="30,8"/>
    </Grid>
</Window>
